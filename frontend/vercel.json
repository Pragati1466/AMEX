{
  "version": 2,
  "name": "disputiq-frontend",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/((?!.*\\.[a-zA-Z0-9]{2,5}$).*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://disputiq-api.onrender.com"
  }
}


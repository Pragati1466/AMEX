    {
      "name": "Investigation Workflow",
      "item": [
        {
          "name": "Run Investigation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"clear_existing\": false\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/v1/investigate/:dispute_id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "investigate", ":dispute_id"],
              "variable": [
                {
                  "key": "dispute_id",
                  "value": "1",
                  "description": "Dispute ID to investigate"
                }
              ]
            },
            "description": "Trigger complete investigation workflow for a dispute"
        },
        {
          "name": "Get Investigation Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/v1/investigate/:dispute_id/status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "investigate", ":dispute_id", "status"],
              "variable": [
                {
                  "key": "dispute_id",
                  "value": "1",
                  "description": "Dispute ID"
                }
              ]
            },
            "description": "Get current investigation status"
        },
        {
          "name": "Submit Investigation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/v1/investigate/:dispute_id/submit",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "investigate", ":dispute_id", "submit"],
              "variable": [
                {
                  "key": "dispute_id",
                  "value": "1",
                  "description": "Dispute ID"
                }
              ]
            },
            "description": "Submit completed investigation"
        }
      ]
    },
